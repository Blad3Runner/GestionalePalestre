// Database schema for Gestionale Palestre.
//
// The agreed table design lives in docs/data-model.md. Tables arrive step by step:
// `dim_person` in Step 2 (this file), `dim_gym` and the tenant rule in Step 3, and so on.
// Do not add tables ahead of the step that calls for them.
//
// Table names are snake_case, matching docs/data-model.md, via @@map. Prisma model
// names stay PascalCase because that is how they are read in TypeScript.
//
// ⚠ EVERY TIMESTAMP IS GENERATED BY THE DATABASE, never by the application.
//
// This is not a style preference. Timestamps written from the application arrived two
// hours adrift — the local UTC offset — while everything the database wrote was correct
// (found 2026-07-30, see docs/decisions.md). In a system where credits expire twelve
// months from purchase, cancellation is free until exactly 24 hours before, and the
// discount depends on which Monday–Sunday week a session falls in, a two-hour error is
// money.
//
// So: `@default(dbgenerated("CURRENT_TIMESTAMP"))` rather than `@default(now())`, and a
// database trigger rather than `@updatedAt`. There is one clock, and it is PostgreSQL's.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// The five roles of the platform.
///
/// PLATFORM_ADMIN is genuinely global — the founders, who belong to no company.
/// The other four describe what somebody does at a company or at one of its gyms,
/// and live on `bridge_membership`. Step 4 reduces `person_role` to PLATFORM_ADMIN only.
enum Role {
  PLATFORM_ADMIN
  GYM_OWNER
  STAFF
  TRAINER
  MEMBER
}

/// How much of the platform a request may see. Set on the badge at the start of every
/// transaction; the Row-Level Security policies read it from there.
enum AccessLevel {
  /// The founders. Everything, across every company.
  PLATFORM
  /// An owner with visibility over every gym of their own circuit.
  COMPANY
  /// Owner-type access restricted to a single gym.
  GYM
  /// Trainers, doctors, front desk: their gym only, no financial data.
  WORKER
  /// A client: their own rows, plus their gym's published catalogue.
  CLIENT
}

/// The languages the interface is available in. Italian is the default.
enum Language {
  IT
  EN
}

/// Where a member stands with the business.
///
/// Step 4 records these transitions; it does not trigger them. Lead → Starter follows a
/// Starter Pack purchase (Step 7), Starter → Client the first credit recharge (Step 7),
/// and Dormant needs consumption to measure (Step 6). See the open question about how
/// long "no consumption" has to last.
enum LifecycleState {
  LEAD
  STARTER
  CLIENT
  DORMANT
  CHURN
}

/// How a trainer is paid. Seniority lives here — it changes what a trainer earns, never
/// what a client pays (docs/decisions.md, 2026-07-30).
enum CompensationModel {
  /// Typically a junior trainer.
  PER_SESSION
  /// Typically a senior trainer; the blueprint calls this right for group PT.
  REVENUE_SHARE
  /// The owner training in his own studio.
  OWNER_DRAW
}

/// The tenant: a company, which may run several gyms.
///
/// Isolation happens here, not at the gym (docs/decisions.md, 2026-07-30). Every tenant
/// table carries `companyId`, and the Row-Level Security policies compare it against the
/// badge set at the start of the transaction.
model Company {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @db.VarChar(200)
  /// Partita IVA / codice fiscale. Not validated yet — the fiscal module comes later.
  fiscalId  String?  @map("fiscal_id") @db.VarChar(40)
  isActive  Boolean  @default(true) @map("is_active")
  /// The company defines the catalogue. Gyms override only price and opening hours.
  settings  Json     @default("{}")
  createdAt DateTime @default(dbgenerated("CURRENT_TIMESTAMP")) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(dbgenerated("CURRENT_TIMESTAMP")) @map("updated_at") @db.Timestamptz(6)

  gyms        Gym[]
  memberships Membership[]

  @@map("dim_company")
}

/// One location. Belongs to exactly one company.
model Gym {
  id        String   @id @default(uuid()) @db.Uuid
  companyId String   @map("company_id") @db.Uuid
  name      String   @db.VarChar(200)
  city      String?  @db.VarChar(120)
  /// Drives the Monday–Sunday week for the frequency discount. No `dim_date` table.
  timezone  String   @default("Europe/Rome") @db.VarChar(60)
  isActive  Boolean  @default(true) @map("is_active")
  /// Overrides ONLY price and opening hours — a short explicit list, never a general
  /// override mechanism (docs/decisions.md, 2026-07-30).
  settings  Json     @default("{}")
  createdAt DateTime @default(dbgenerated("CURRENT_TIMESTAMP")) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(dbgenerated("CURRENT_TIMESTAMP")) @map("updated_at") @db.Timestamptz(6)

  company     Company      @relation(fields: [companyId], references: [id], onDelete: Restrict)
  memberships Membership[]

  @@index([companyId])
  @@map("dim_gym")
}

/// Who is what, where.
///
/// **Step 3 creates only what the badge needs.** Lifecycle state, the member's level and
/// package cap, the trainer's fields and the joined/left dates all arrive in Step 4
/// (docs/decisions.md, 2026-07-30).
model Membership {
  id        String   @id @default(uuid()) @db.Uuid
  personId  String   @map("person_id") @db.Uuid
  companyId String   @map("company_id") @db.Uuid
  /// **Null means the role covers every gym of the company.** Set means this one only.
  gymId     String?  @map("gym_id") @db.Uuid
  role      Role
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(dbgenerated("CURRENT_TIMESTAMP")) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(dbgenerated("CURRENT_TIMESTAMP")) @map("updated_at") @db.Timestamptz(6)

  // --- Step 4 ---------------------------------------------------------------

  joinedAt DateTime  @default(dbgenerated("CURRENT_TIMESTAMP")) @map("joined_at") @db.Timestamptz(6)
  /// Set when somebody leaves. Nobody is ever deleted — history stays attributed.
  leftAt   DateTime? @map("left_at") @db.Timestamptz(6)

  /// Member rows only. Where this person stands with the business.
  lifecycleState LifecycleState? @map("lifecycle_state")
  /// Member rows only. A plain value; the permitted ones live in gym configuration.
  level          String?         @db.VarChar(60)
  /// Member rows only. The largest group their package allows — the "da 2/3/4".
  packageCap     Int?            @map("package_cap")
  /// Member rows only. Their usual trainer, as a membership at the same gym.
  defaultTrainerId String?       @map("default_trainer_id") @db.Uuid

  /// Trainer rows only. Deactivated rather than deleted, so past work stays theirs.
  deactivatedAt DateTime? @map("deactivated_at") @db.Timestamptz(6)

  person  Person  @relation(fields: [personId], references: [id], onDelete: Cascade)
  company Company @relation(fields: [companyId], references: [id], onDelete: Restrict)
  gym     Gym?    @relation(fields: [gymId], references: [id], onDelete: Restrict)

  defaultTrainer Membership?  @relation("DefaultTrainer", fields: [defaultTrainerId], references: [id], onDelete: SetNull)
  clientsAssigned Membership[] @relation("DefaultTrainer")

  lifecycleEvents LifecycleEvent[]
  compensations   TrainerCompensation[]

  @@unique([personId, companyId, gymId, role])
  @@index([companyId])
  @@index([gymId])
  @@index([personId])
  @@index([defaultTrainerId])
  @@map("bridge_membership")
}

/// Every lifecycle change, with its date. The backbone of the funnel diagnostics.
///
/// Append-only in practice: a state is changed by adding a row here and updating the
/// membership, never by rewriting what happened before.
model LifecycleEvent {
  id           String          @id @default(uuid()) @db.Uuid
  membershipId String          @map("membership_id") @db.Uuid
  companyId    String          @map("company_id") @db.Uuid
  gymId        String?         @map("gym_id") @db.Uuid
  /// Null for the very first state a person is given.
  fromState    LifecycleState? @map("from_state")
  toState      LifecycleState  @map("to_state")
  occurredAt   DateTime        @default(dbgenerated("CURRENT_TIMESTAMP")) @map("occurred_at") @db.Timestamptz(6)
  /// Who recorded it. Null when a scheduled job did, which will happen from Step 6.
  recordedById String?         @map("recorded_by_id") @db.Uuid
  note         String?         @db.VarChar(500)

  membership Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)

  @@index([membershipId])
  @@index([companyId])
  @@index([occurredAt])
  @@map("fact_lifecycle_event")
}

/// How a trainer is paid, dated so a change never rewrites what was already earned.
model TrainerCompensation {
  id           String            @id @default(uuid()) @db.Uuid
  membershipId String            @map("membership_id") @db.Uuid
  companyId    String            @map("company_id") @db.Uuid
  gymId        String?           @map("gym_id") @db.Uuid
  model        CompensationModel
  /// Credits per session for PER_SESSION, or a percentage for REVENUE_SHARE.
  /// NUMERIC, never a floating-point number: money must not drift.
  amount       Decimal?          @db.Decimal(12, 2)
  validFrom    DateTime          @default(dbgenerated("CURRENT_TIMESTAMP")) @map("valid_from") @db.Timestamptz(6)
  validTo      DateTime?         @map("valid_to") @db.Timestamptz(6)
  createdAt    DateTime          @default(dbgenerated("CURRENT_TIMESTAMP")) @map("created_at") @db.Timestamptz(6)

  membership Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)

  @@index([membershipId])
  @@index([companyId])
  @@map("dim_trainer_compensation")
}

/// Who changed what, when, before and after.
///
/// **Written by database triggers, never by application code**, so it cannot be
/// forgotten by whoever adds the next feature. The application is granted SELECT only:
/// it can read the trail but can neither forge an entry nor erase one.
model AuditLog {
  id         BigInt   @id @default(autoincrement())
  companyId  String?  @map("company_id") @db.Uuid
  gymId      String?  @map("gym_id") @db.Uuid
  tableName  String   @map("table_name") @db.VarChar(63)
  rowId      String?  @map("row_id") @db.VarChar(64)
  action     String   @db.VarChar(10)
  /// Taken from the badge the transaction was carrying. Null for a scheduled job.
  changedById String? @map("changed_by_id") @db.Uuid
  changedAt  DateTime @default(dbgenerated("CURRENT_TIMESTAMP")) @map("changed_at") @db.Timestamptz(6)
  before     Json?
  after      Json?

  @@index([companyId, changedAt])
  @@index([tableName, rowId])
  @@map("audit_log")
}

/// A human being — one global identity, deliberately carrying no company_id.
/// The same individual can be a member at one company and a trainer at another
/// (docs/decisions.md, 2026-07-29).
model Person {
  id           String   @id @default(uuid()) @db.Uuid
  name         String   @db.VarChar(200)
  /// Stored lower-cased so that sign-in is not case-sensitive.
  email        String   @unique @db.VarChar(320)
  /// A bcrypt hash. The plain password is never stored, logged or returned.
  passwordHash String   @map("password_hash") @db.VarChar(60)
  phone        String?  @db.VarChar(40)
  language     Language @default(IT)
  createdAt    DateTime @default(dbgenerated("CURRENT_TIMESTAMP")) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @default(dbgenerated("CURRENT_TIMESTAMP")) @map("updated_at") @db.Timestamptz(6)

  roles               PersonRole[]
  passwordResetTokens PasswordResetToken[]
  memberships         Membership[]

  @@map("dim_person")
}

/// Which roles a person holds. One row per role, so a person can hold several —
/// the founding studio's owner is both GYM_OWNER and TRAINER.
model PersonRole {
  id       String   @id @default(uuid()) @db.Uuid
  personId String   @map("person_id") @db.Uuid
  role     Role
  grantedAt DateTime @default(dbgenerated("CURRENT_TIMESTAMP")) @map("granted_at") @db.Timestamptz(6)

  person Person @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@unique([personId, role])
  @@index([role])
  @@map("person_role")
}

/// A pending "I forgot my password" request.
///
/// Only a hash of the token is stored, so that a leaked database still does not let
/// anyone reset an account — the same reasoning as never storing plain passwords.
model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  personId  String    @map("person_id") @db.Uuid
  tokenHash String    @unique @map("token_hash") @db.VarChar(64)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(6)
  createdAt DateTime  @default(dbgenerated("CURRENT_TIMESTAMP")) @map("created_at") @db.Timestamptz(6)

  person Person @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@index([personId])
  @@map("password_reset_token")
}
