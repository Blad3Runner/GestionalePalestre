# Dependencies
node_modules/
.pnp/
.pnp.js

# Build output
dist/
build/
.next/
out/
*.tsbuildinfo
next-env.d.ts

# Generated code — rebuilt by `npm install` / `npm run db:generate`, never edited
src/generated/

# Vendor agent skills installed by tooling, useful locally, not part of the project
.claude/skills/

# Environment and secrets — NEVER commit these
.env
.env.*
!.env.example
*.pem
*.key
secrets/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Test and coverage output
coverage/
.nyc_output/
test-results/
playwright-report/

# Local database / backup dumps
*.sql.gz
*.dump
backups/

# Editors and OS
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.swp
Thumbs.db
Desktop.ini
$RECYCLE.BIN/
.DS_Store

# Temporary
tmp/
temp/
.cache/
