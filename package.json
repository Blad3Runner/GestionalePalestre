{
  "name": "gestionale-palestre",
  "version": "0.1.0",
  "private": true,
  "description": "Multi-tenant web platform for managing training businesses",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "postinstall": "prisma generate",
    "db:setup-roles": "node scripts/setup-database-roles.ts",
    "db:migrate": "prisma migrate dev",
    "db:seed": "node prisma/seed.ts",
    "db:generate": "prisma generate",
    "db:studio": "prisma studio",
    "db:reset-demo": "node scripts/reset-demo.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "bcryptjs": "^3.0.3",
    "next": "^16.2.12",
    "next-auth": "^5.0.0-beta.32",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "resend": "^6.18.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "dotenv": "^17.4.2",
    "prisma": "^7.9.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  }
